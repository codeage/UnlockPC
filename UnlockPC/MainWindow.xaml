<?xml version="1.0" encoding="utf-8"?>
<wk:ThemedWindow
x:Class="UnlockPC.MainWindow"
xmlns:wk="using:WinUIKit"
xmlns:local="using:UnlockPC"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
Title="UnlockPC">

<Window.SystemBackdrop>
<MicaBackdrop Kind="Base" />
</Window.SystemBackdrop>

<Grid x:Name="WindowRootGrid" Background="Transparent">
<Grid.RowDefinitions>
<RowDefinition Height="48" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>

<Grid x:Name="AppTitleBar"
      Margin="48,0,0,0"
      Background="Transparent"
      Canvas.ZIndex="200">
<StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
<TextBlock Text="UnlockPC" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
</StackPanel>
</Grid>

<!-- NavigationView 与窗口顶边齐平；标题栏叠放在其上。 -->
<Grid Grid.Row="0" Grid.RowSpan="2">
<Grid.Resources>
<Style x:Key="SettingsCardStyle" TargetType="Border">
<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
<Setter Property="BorderThickness" Value="1" />
<Setter Property="CornerRadius" Value="4" />
<Setter Property="Padding" Value="16,10" />
<Setter Property="MinHeight" Value="52" />
</Style>
</Grid.Resources>

<NavigationView x:Name="RootNavigationView"
IsBackButtonVisible="Collapsed"
IsSettingsVisible="False"
PaneDisplayMode="Left"
IsPaneToggleButtonVisible="True"
OpenPaneLength="224"
CompactPaneLength="48"
SelectionChanged="RootNavigationView_SelectionChanged">
<NavigationView.MenuItems>
<NavigationViewItem x:Name="DeviceRadarItem" Content="设备检测">
    <NavigationViewItem.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
</NavigationViewItem>
<NavigationViewItem x:Name="WatchManagementItem" Content="手表管理">
    <NavigationViewItem.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE916;" /></NavigationViewItem.Icon>
</NavigationViewItem>
<NavigationViewItem x:Name="MonitorItem" Content="在场检测" Icon="Find" />
<NavigationViewItem x:Name="TrialsItem" Content="漏检测量">
<NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
</NavigationViewItem>
<NavigationViewItem x:Name="AdvancedItem" Content="高级选项" Icon="Setting" />
<NavigationViewItem x:Name="DiagnosticsItem" Content="诊断">
    <NavigationViewItem.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE90F;" /></NavigationViewItem.Icon>
</NavigationViewItem>
<NavigationViewItem x:Name="AboutItem" Content="关于">
    <NavigationViewItem.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" /></NavigationViewItem.Icon>
</NavigationViewItem>
</NavigationView.MenuItems>


<Grid>
<Grid x:Name="DeviceRadarPage" Margin="16,0,16,16" Visibility="Collapsed">
    <Grid.Resources>
        <LinearGradientBrush x:Key="RadarDeviceScreenBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0" Color="{ThemeResource SystemAccentColor}" />
            <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorLight2}" />
        </LinearGradientBrush>
    </Grid.Resources>
    <Canvas x:Name="RadarCanvas" SizeChanged="RadarCanvas_SizeChanged" IsHitTestVisible="False">
        <Viewbox x:Name="RadarDial">
            <Viewbox.Clip><RectangleGeometry x:Name="RadarDialClip" /></Viewbox.Clip>
            <Grid Width="320" Height="320">
                <Ellipse Opacity="0.06">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="{ThemeResource SystemAccentColor}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Align the fade bands in dial coordinates so the arcs disappear at the lower edge. -->
                <Ellipse Width="302" Height="302" StrokeThickness="0.48" Opacity="0.13">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.56" Color="{ThemeResource SystemAccentColor}" />
                            <GradientStop Offset="0.72" Color="Transparent" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
                <Ellipse Width="220" Height="220" StrokeThickness="0.52" Opacity="0.17">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.59" Color="{ThemeResource SystemAccentColor}" />
                            <GradientStop Offset="0.80" Color="Transparent" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
                <Ellipse Width="122" Height="122" StrokeThickness="0.56" Opacity="0.21">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.66" Color="{ThemeResource SystemAccentColor}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>
                <Ellipse x:Name="RadarPulse" RenderTransformOrigin="0.5,0.5" Opacity="0" Visibility="Collapsed">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="RadarPulseScale" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0.54" Color="Transparent" />
                            <GradientStop Offset="0.77" Color="{ThemeResource SystemAccentColor}" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Viewbox>
        <!-- Microsoft Fluent System Icons, Desktop 32 Filled (MIT). -->
        <Viewbox x:Name="RadarComputer" Width="48" Height="48">
            <Canvas Width="32" Height="32">
                <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="F1 M2 6.25C2 4.45507 3.45507 3 5.25 3H26.75C28.5449 3 30 4.45507 30 6.25V21.75C30 23.5449 28.5449 25 26.75 25H20.0059V27.0012L23.0042 27.0012C23.5565 27.0012 24.0042 27.4486 24.0042 28.0005C24.0042 28.5525 23.5565 28.9999 23.0043 28.9999L9.01197 29C8.45969 29 8.01197 28.5526 8.01196 28.0007C8.01196 27.4488 8.45967 27.0013 9.01196 27.0013L12.01 27.0013V25H5.25C3.45507 25 2 23.5449 2 21.75V6.25ZM14.01 25V27.0013L18.0059 27.0013V25H14.01Z" />
                <Rectangle Canvas.Left="4.5" Canvas.Top="5.5" Width="23" Height="17" RadiusX="1.4" RadiusY="1.4"
                           Fill="{StaticResource RadarDeviceScreenBrush}" />
            </Canvas>
        </Viewbox>
        <Canvas x:Name="RadarMarker" Width="1" Height="1" Visibility="Collapsed">
            <Border Canvas.Left="-19" Canvas.Top="-19" Width="38" Height="38" CornerRadius="19"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <!-- Microsoft Fluent System Icons, Smartwatch 24 Filled (MIT). -->
                <Viewbox Width="29" Height="29" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="F1 M9.5 2C8.39543 2 7.5 2.89543 7.5 4V5.29076C7.96322 5.10325 8.46955 5 9 5H15C15.5304 5 16.0368 5.10325 16.5 5.29076V4C16.5 2.89543 15.6046 2 14.5 2H9.5ZM9 6C7.34315 6 6 7.34315 6 9V15C6 16.6569 7.34315 18 9 18H15C16.6569 18 18 16.6569 18 15V13C18.5523 13 19 12.5523 19 12V11C19 10.4477 18.5523 10 18 10V9C18 7.34315 16.6569 6 15 6H9ZM9 19C8.46955 19 7.96322 18.8967 7.5 18.7092V20C7.5 21.1046 8.39543 22 9.5 22H14.5C15.6046 22 16.5 21.1046 16.5 20V18.7092C16.0368 18.8967 15.5305 19 15 19H9Z" />
                        <Rectangle Canvas.Left="7.5" Canvas.Top="7.5" Width="9" Height="9" RadiusX="1.9" RadiusY="1.9"
                                   Fill="{StaticResource RadarDeviceScreenBrush}" />
                        <Path Data="M 12,9.5 L 12,12 L 13.7,13.1" Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel x:Name="RadarDeviceLabel" Canvas.Top="25" Spacing="2">
                <TextBlock x:Name="RadarDeviceName" Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RadarDeviceSignal" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
        </Canvas>
    </Canvas>
</Grid>

<ScrollViewer x:Name="ContentScrollViewer"
Margin="0,48,0,0"
Padding="16,0,16,16"
HorizontalScrollMode="Disabled"
HorizontalScrollBarVisibility="Disabled"
VerticalScrollBarVisibility="Auto"
SizeChanged="ContentScrollViewer_SizeChanged">
<Grid x:Name="ContentColumn" MaxWidth="960" HorizontalAlignment="Center" RowSpacing="24">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>

<StackPanel Spacing="8">
    <Grid x:Name="PageTitleRow" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
    </Grid>
    <TextBlock x:Name="PageDescriptionText" Style="{StaticResource BodyTextBlockStyle}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
</StackPanel>

<StackPanel x:Name="WatchManagementPage" Grid.Row="1" Spacing="6" Visibility="Collapsed">
    <StackPanel.Resources>
        <Style x:Key="WatchSettingCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
        <Style x:Key="WatchSettingRowStyle" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="WatchSettingLabelsStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="WatchSettingDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="WatchSettingSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="56" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="UnlockSettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <!-- Microsoft Fluent System Icons, Question Circle 16 Regular (MIT). -->
        <DataTemplate x:Key="WatchSettingHelpIcon">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Fill="{ThemeResource TextFillColorSecondaryBrush}" Data="F1 M8 1C11.866 1 15 4.13401 15 8C15 11.866 11.866 15 8 15C4.13401 15 1 11.866 1 8C1 4.13401 4.13401 1 8 1ZM8 2C4.68629 2 2 4.68629 2 8C2 11.3137 4.68629 14 8 14C11.3137 14 14 11.3137 14 8C14 4.68629 11.3137 2 8 2ZM8 10.5C8.41421 10.5 8.75 10.8358 8.75 11.25C8.75 11.6642 8.41421 12 8 12C7.58579 12 7.25 11.6642 7.25 11.25C7.25 10.8358 7.58579 10.5 8 10.5ZM8 4C9.10457 4 10 4.89543 10 6C10 6.45796 9.87522 6.8032 9.6748 7.08887C9.49738 7.34169 9.24942 7.55239 9.09668 7.69922C8.92663 7.86268 8.78826 8.01726 8.68555 8.2334C8.58291 8.44944 8.5 8.7612 8.5 9.25C8.5 9.52614 8.27614 9.75 8 9.75C7.72386 9.75 7.5 9.52614 7.5 9.25C7.5 8.64401 7.60468 8.18045 7.7832 7.80469C7.96165 7.42917 8.19844 7.17548 8.40332 6.97852C8.62547 6.76497 8.75265 6.66255 8.85645 6.51465C8.93728 6.39943 9 6.25513 9 6C9 5.44772 8.55228 5 8 5C7.44772 5 7 5.44772 7 6C7 6.27614 6.77614 6.5 6.5 6.5C6.22386 6.5 6 6.27614 6 6C6 4.89543 6.89543 4 8 4Z" />
        </DataTemplate>
        <Style x:Key="WatchSettingHelpStyle" TargetType="Button">
            <Setter Property="Content" Value="?" />
            <Setter Property="ContentTemplate" Value="{StaticResource WatchSettingHelpIcon}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </StackPanel.Resources>

    <InfoBar x:Name="WatchManagementStatus" IsClosable="True" />
    <TextBlock Text="设备" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
    <Border Style="{StaticResource WatchSettingCardStyle}">
        <Grid Style="{StaticResource WatchSettingRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE916;" FontSize="20" />
            <StackPanel Grid.Column="1" Style="{StaticResource WatchSettingLabelsStyle}">
                <TextBlock x:Name="ManagedWatchName" Text="尚未绑定手表"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="ConnectionStatusText" Text="正在查找已配对手表…"
                           Style="{StaticResource WatchSettingDetailStyle}" />
                <TextBlock x:Name="DirectUnlockStatus" Style="{StaticResource WatchSettingDetailStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PairButton" Content="绑定手表…" Click="StartPairing_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="RemoveWatchButton" Content="移除…" Click="RemoveWatch_Click"
                        AutomationProperties.Name="移除手表" IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Border>

    <InfoBar x:Name="WatchManagementRulesStatus" IsClosable="True" />
    <TextBlock Text="自动解锁" Style="{StaticResource BodyStrongTextBlockStyle}"
               Margin="0,16,0,0" AutomationProperties.HeadingLevel="Level2" />
    <Border Style="{StaticResource WatchSettingCardStyle}" Padding="0">
        <StackPanel>
            <Border Style="{StaticResource UnlockSettingRowStyle}" BorderThickness="0">
                <Grid Style="{StaticResource WatchSettingRowStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="自动解锁" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="AutoUnlockSwitch" Grid.Column="1" Style="{StaticResource WatchSettingSwitchStyle}"
                                  AutomationProperties.Name="自动解锁" Toggled="WatchRuleToggleChanged" />
                </Grid>
            </Border>
            <Border Style="{StaticResource UnlockSettingRowStyle}">
                <Grid Style="{StaticResource WatchSettingRowStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="解锁方式" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox x:Name="UnlockModeBox" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                              AutomationProperties.Name="解锁方式" Loaded="UnlockModeBox_Loaded"
                              SelectionChanged="UnlockModeBox_SelectionChanged">
                        <ComboBoxItem x:Name="PasswordUnlockMode" Content="自动解锁" />
                        <ComboBoxItem x:Name="WindowsHelloMode" Content="仅亮屏" />
                    </ComboBox>
                </Grid>
            </Border>
            <StackPanel x:Name="PasswordUnlockSettings" Visibility="Collapsed">
                <Border Style="{StaticResource UnlockSettingRowStyle}">
                    <Grid Style="{StaticResource WatchSettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource WatchSettingLabelsStyle}">
                            <TextBlock Text="Windows 登录密码" TextWrapping="Wrap" />
                            <TextBlock x:Name="UnlockCredentialDescription" Text="输入你当前用于登录 Windows 的密码。"
                                       Style="{StaticResource WatchSettingDetailStyle}" />
                        </StackPanel>
                        <Button x:Name="SetUnlockCredentialButton" Grid.Column="1" Content="输入 Windows 登录密码"
                                Click="SetUnlockCredential_Click" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource UnlockSettingRowStyle}">
                    <Grid Style="{StaticResource WatchSettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource WatchSettingLabelsStyle}">
                            <TextBlock Text="验证手表解锁状态" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="开启后可防止他人盗用你的手表解锁" VerticalAlignment="Center"
                                           Style="{StaticResource WatchSettingDetailStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource WatchSettingHelpStyle}"
                                        AutomationProperties.Name="Apple Watch 何时解锁"
                                        ToolTipService.ToolTip="已设置密码且开启「手腕检测」时，Apple Watch 摘下后会自动锁定。重新佩戴后，可输入手表密码解锁。如果已开启「用 iPhone 解锁」，也可以在手表附近解锁配对的 iPhone。" />
                            </Grid>
                        </StackPanel>
                        <ToggleSwitch x:Name="RequireWatchUnlockedSwitch" Grid.Column="1" Style="{StaticResource WatchSettingSwitchStyle}"
                                      AutomationProperties.Name="验证手表解锁状态" Toggled="WatchRuleToggleChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource UnlockSettingRowStyle}">
                    <Grid Style="{StaticResource WatchSettingRowStyle}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource WatchSettingLabelsStyle}">
                            <TextBlock Text="使用增强的蓝牙加密认证" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="4" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="开启后可防止广播回放攻击" VerticalAlignment="Center"
                                           Style="{StaticResource WatchSettingDetailStyle}" />
                                <Button Grid.Column="1" Style="{StaticResource WatchSettingHelpStyle}"
                                        AutomationProperties.Name="什么是广播回放攻击"
                                        ToolTipService.ToolTip="广播回放是指把手表之前发出的蓝牙广播录下来，再原样重发，让电脑误以为手表就在附近。开启增强认证后，其他人无法使用广播重放来伪装你的手表解锁 Windows。" />
                            </Grid>
                        </StackPanel>
                        <ToggleSwitch x:Name="RequireEncryptedConnectionSwitch" Grid.Column="1" Style="{StaticResource WatchSettingSwitchStyle}"
                                      AutomationProperties.Name="使用增强的蓝牙加密认证" Toggled="WatchRuleToggleChanged" />
                    </Grid>
                </Border>
            </StackPanel>
            <Border x:Name="WindowsHelloSettings" Style="{StaticResource UnlockSettingRowStyle}" Visibility="Collapsed">
                <StackPanel Style="{StaticResource WatchSettingLabelsStyle}">
                    <TextBlock Text="Windows Hello" TextWrapping="Wrap" />
                    <TextBlock Text="仅亮屏，让Windows Hello解锁，安全性更高。" Style="{StaticResource WatchSettingDetailStyle}" />
                    <TextBlock x:Name="WatchWakeStatus" Style="{StaticResource WatchSettingDetailStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

    <TextBlock Text="自动锁定" Style="{StaticResource BodyStrongTextBlockStyle}"
               Margin="0,16,0,0" AutomationProperties.HeadingLevel="Level2" />
    <Border Style="{StaticResource WatchSettingCardStyle}">
        <Grid Style="{StaticResource WatchSettingRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource WatchSettingLabelsStyle}">
                <TextBlock Text="自动锁定" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="手表信号持续变弱且电脑无输入时锁屏。" Style="{StaticResource WatchSettingDetailStyle}" />
            </StackPanel>
            <ToggleSwitch x:Name="AutoLockSwitch" Grid.Column="1" Style="{StaticResource WatchSettingSwitchStyle}"
                          AutomationProperties.Name="自动锁定" Toggled="WatchRuleToggleChanged" />
        </Grid>
    </Border>
</StackPanel>

<StackPanel x:Name="MonitorPage" Grid.Row="1" Spacing="12">
    <InfoBar x:Name="ScanError" IsClosable="False" Severity="Warning" />
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="StartScanButton" Content="开始检测" Click="StartScan_Click"
                Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
        <Button x:Name="StopScanButton" Content="停止" Click="StopScan_Click" IsEnabled="False" />
    </StackPanel>

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock x:Name="PresenceText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="LastSeenText" TextWrapping="Wrap" />
            <TextBlock x:Name="RssiText" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="PacketCountText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="IRK 换址验证" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartIrkButton" Content="自动读取并验证" Click="StartIrk_Click" IsEnabled="False" />
                <Button x:Name="StopIrkButton" Content="结束 IRK 验证" Click="StopIrk_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="IrkStatusText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="IrkError" IsClosable="False" Severity="Warning" />
        </StackPanel>
    </Border>

    <Border x:Name="RawAdvertisementsCard" Style="{StaticResource SettingsCardStyle}" Visibility="Collapsed">
        <StackPanel Spacing="8">
            <TextBlock Text="蓝牙广播" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <ToggleSwitch x:Name="MatchingAdvertisementsSwitch" Header="仅显示匹配记录"
                              IsOn="True" OnContent="开" OffContent="关" />
                <ToggleSwitch x:Name="AutoScrollAdvertisementsSwitch" Header="自动滚动"
                              IsOn="True" OnContent="开" OffContent="关" />
            </StackPanel>
            <TextBlock x:Name="AdvertisementsStatusText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="AdvertisementsList" Height="360" SelectionMode="None"
                      AutomationProperties.Name="最近收到的蓝牙广播">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AdvertisementRow">
                        <StackPanel Spacing="4" Padding="0,8">
                            <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Payload}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</StackPanel>

<StackPanel x:Name="TrialsPage" Grid.Row="1" Spacing="12" Visibility="Collapsed">
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <ComboBox x:Name="ScenarioBox" Header="手表状态" SelectedIndex="0">
                <ComboBoxItem Content="亮屏且已解锁" />
                <ComboBoxItem Content="熄屏且已解锁" />
                <ComboBoxItem Content="重新锁定" />
                <ComboBoxItem Content="重启后尚未解锁" />
            </ComboBox>
            <TextBlock Text="开始检测后，将手表保持在接收范围内并维持选定状态。每轮 60 秒，每 10 秒统计一次是否收到匹配广播。" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button x:Name="StartTrialButton" Content="开始本轮" Click="StartTrial_Click"
                        Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                <Button x:Name="CancelTrialButton" Content="取消本轮" Click="CancelTrial_Click" IsEnabled="False" />
            </StackPanel>
            <ProgressBar x:Name="TrialProgress" Maximum="60" Visibility="Collapsed" />
            <TextBlock x:Name="TrialStatusText" Text="请先在「在场检测」开启检测。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="本次运行的测量结果" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="SummaryText" Text="暂无完整测量。" TextWrapping="Wrap" />
            <Button x:Name="CopyResultsButton" Content="复制逐窗口 CSV" Click="CopyResults_Click" IsEnabled="False" />
            <InfoBar x:Name="CopyStatus" IsClosable="True" />
        </StackPanel>
    </Border>
</StackPanel>
<StackPanel x:Name="AdvancedPage" Grid.Row="1" Spacing="12" Visibility="Collapsed">
    <InfoBar x:Name="WatchRulesStatus" IsClosable="True" />
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="Apple Watch 蓝牙连接测试" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="测试当前手表。确认连接后立即结束，等待新连接最多 10 秒。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="WatchConnectionLiveStatus" Text="当前连接（Windows）：未选择手表"
                       TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button x:Name="TestWatchConnectionButton" Content="测试蓝牙连接" Click="TestWatchConnection_Click" />
            <InfoBar x:Name="WatchConnectionTestStatus" IsClosable="False" />
        </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <ToggleSwitch x:Name="SpeakLockActivitySwitch" Header="播报锁定与解锁过程" Toggled="WatchRuleToggleChanged" />
            <TextBlock Text="新步骤会打断当前播报。结束时播报总耗时。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
</StackPanel>
<StackPanel x:Name="DiagnosticsPage" Grid.Row="1" Spacing="12" Visibility="Collapsed">
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="诊断日志" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button Content="打开应用日志目录" Click="OpenLogs_Click" />
            <Button Content="打开服务日志目录" Click="OpenServiceLogs_Click" />
        </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="清除应用数据" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="按类别选择要清除的内容，然后重启 UnlockPC。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="ResetDataButton" Content="分类清除并重启…" Click="ResetData_Click" />
        </StackPanel>
    </Border>
    <InfoBar x:Name="DiagnosticsStatus" IsClosable="True" />
</StackPanel>
<StackPanel x:Name="AboutPage" Grid.Row="1" Spacing="12" Visibility="Collapsed">
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="UnlockPC" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="AboutVersionText" />
            <TextBlock Text="用 Apple Watch 检测在场，并按设定管理 Windows 锁定和解锁。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton Content="GitHub 项目" NavigateUri="https://github.com/codeage/UnlockPC" />
        </StackPanel>
    </Border>
</StackPanel>
</Grid>
</ScrollViewer>
    <Grid x:Name="RadarDebugPanel" Margin="0,60,24,16" Width="320" MaxHeight="600" RowSpacing="10"
          HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="WatchBroadcastCard" MaxHeight="420" Padding="14,12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Resources>
                <Style x:Key="WatchFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="WatchFieldValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
            </Border.Resources>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="手表状态" FontSize="16" FontWeight="SemiBold" />
                <Grid Grid.Row="1">
                    <TextBlock x:Name="WatchBroadcastStoppedText" Text="检测已停止" Style="{StaticResource WatchFieldLabel}" Visibility="Collapsed" />
                    <Grid x:Name="WatchBroadcastSummary" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="佩戴" Style="{StaticResource WatchFieldLabel}" />
                            <TextBlock x:Name="WatchWristValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="锁定" Style="{StaticResource WatchFieldLabel}" />
                            <TextBlock x:Name="WatchLockValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="屏幕" Style="{StaticResource WatchFieldLabel}" />
                            <TextBlock x:Name="WatchScreenValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <ScrollViewer x:Name="WatchBroadcastScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="手表广播状态位">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nearby Info  0x10" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="WatchNearbySourceText" Style="{StaticResource WatchFieldLabel}" />
                            <StackPanel x:Name="WatchNearbyDetails" Spacing="6">
                                <TextBlock x:Name="WatchNearbyInfoText" Style="{StaticResource WatchFieldValue}" />
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="锁定线索" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchLockFlagText" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                    <TextBlock Grid.Row="1" Text="解锁线索" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchAutoUnlockFlagText" Grid.Row="1" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                    <TextBlock Grid.Row="2" Text="手表自动解锁" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchWatchUnlockFlagText" Grid.Row="2" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                    <TextBlock Grid.Row="3" Text="认证标签" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchAuthTagText" Grid.Row="3" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                </Grid>
                                <TextBlock x:Name="WatchOtherFlagsText" Style="{StaticResource WatchFieldLabel}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Magic Switch  0x0B" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="WatchMagicSwitchText" Style="{StaticResource WatchFieldValue}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border x:Name="LockActivityCard" Grid.Row="1" VerticalAlignment="Top" Padding="14,12" CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="锁定与解锁流程" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="LockActivityEmptyText" Grid.Row="1" Text="暂无记录" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                <ScrollViewer x:Name="LockActivityScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="锁定与解锁过程记录">
                    <ItemsControl x:Name="LockActivityItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:LockActivityEntry">
                                <Grid Margin="0,0,6,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Timestamp}" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Message}" TextWrapping="Wrap"
                                               Style="{StaticResource BodyTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Grid>
</NavigationView>
</Grid>
</Grid>
</wk:ThemedWindow>




