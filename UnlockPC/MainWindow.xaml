<?xml version="1.0" encoding="utf-8"?>
<wk:ThemedWindow
x:Class="UnlockPC.MainWindow"
xmlns:wk="using:WinUIKit"
xmlns:local="using:UnlockPC"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
Title="UnlockPC">

<Window.SystemBackdrop>
<MicaBackdrop Kind="Base" />
</Window.SystemBackdrop>

<Grid x:Name="WindowRootGrid" Background="Transparent">
<Grid.RowDefinitions>
<RowDefinition Height="48" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>

<Grid x:Name="AppTitleBar"
      Margin="48,0,0,0"
      Background="Transparent"
      Canvas.ZIndex="200">
<StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
<TextBlock Text="UnlockPC" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
</StackPanel>
</Grid>

<!-- NavigationView 与窗口顶边齐平；标题栏叠放在其上。 -->
<Grid Grid.Row="0" Grid.RowSpan="2">
<Grid.Resources>
<Style x:Key="SettingsCardStyle" TargetType="Border">
<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
<Setter Property="BorderThickness" Value="1" />
<Setter Property="CornerRadius" Value="4" />
<Setter Property="Padding" Value="16,10" />
<Setter Property="MinHeight" Value="52" />
</Style>
</Grid.Resources>

<NavigationView x:Name="RootNavigationView"
IsBackButtonVisible="Collapsed"
IsSettingsVisible="False"
PaneDisplayMode="Left"
IsPaneToggleButtonVisible="True"
OpenPaneLength="224"
CompactPaneLength="48"
SelectionChanged="RootNavigationView_SelectionChanged">
<NavigationView.MenuItems>
<NavigationViewItem x:Name="MonitorItem" Content="在场检测" Icon="Find" />
<NavigationViewItem x:Name="TrialsItem" Content="漏检测量">
<NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
</NavigationViewItem>
<NavigationViewItem x:Name="AdvancedItem" Content="高级选项" Icon="Setting" />
</NavigationView.MenuItems>

<NavigationView.PaneFooter>
    <Grid x:Name="WatchSidebar" Margin="12,0,12,12" Height="440" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="WatchBroadcastCard" Padding="12" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Border.Resources>
                <Style x:Key="WatchFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="WatchFieldValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
            </Border.Resources>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="手表当前状态" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ScrollViewer x:Name="WatchBroadcastScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="手表广播状态位">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="WatchBroadcastStoppedText" Text="检测已停止" Style="{StaticResource WatchFieldLabel}" Visibility="Collapsed" />
                        <Grid x:Name="WatchBroadcastSummary" ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="佩戴" Style="{StaticResource WatchFieldLabel}" />
                            <TextBlock x:Name="WatchWristValue" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                            <TextBlock Grid.Row="1" Text="锁定" Style="{StaticResource WatchFieldLabel}" />
                            <TextBlock x:Name="WatchLockValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                            <TextBlock Grid.Row="2" Text="屏幕" Style="{StaticResource WatchFieldLabel}" />
                            <TextBlock x:Name="WatchScreenValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nearby Info  0x10" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="WatchNearbySourceText" Style="{StaticResource WatchFieldLabel}" />
                            <StackPanel x:Name="WatchNearbyDetails" Spacing="6">
                                <TextBlock x:Name="WatchNearbyInfoText" Style="{StaticResource WatchFieldValue}" />
                                <Grid ColumnSpacing="8" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="锁定线索" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchLockFlagText" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                    <TextBlock Grid.Row="1" Text="解锁线索" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchAutoUnlockFlagText" Grid.Row="1" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                    <TextBlock Grid.Row="2" Text="手表自动解锁" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchWatchUnlockFlagText" Grid.Row="2" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                    <TextBlock Grid.Row="3" Text="认证标签" Style="{StaticResource WatchFieldLabel}" />
                                    <TextBlock x:Name="WatchAuthTagText" Grid.Row="3" Grid.Column="1" Style="{StaticResource WatchFieldValue}" />
                                </Grid>
                                <TextBlock x:Name="WatchOtherFlagsText" Style="{StaticResource WatchFieldLabel}" />
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Magic Switch  0x0B" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="WatchMagicSwitchText" Style="{StaticResource WatchFieldValue}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border x:Name="LockActivityFooter" Grid.Row="1" Padding="12" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="锁定与解锁记录" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="LockActivityEmptyText" Grid.Row="1" Text="暂无记录" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                <ScrollViewer x:Name="LockActivityScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="锁定与解锁过程记录">
                    <ItemsControl x:Name="LockActivityItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:LockActivityEntry">
                                <StackPanel Margin="0,0,6,10" Spacing="2">
                                    <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</NavigationView.PaneFooter>

<ScrollViewer x:Name="ContentScrollViewer"
Margin="0,48,0,0"
Padding="16,0,16,16"
HorizontalScrollMode="Disabled"
HorizontalScrollBarVisibility="Disabled"
VerticalScrollBarVisibility="Auto"
SizeChanged="ContentScrollViewer_SizeChanged">
<Grid x:Name="ContentColumn" MaxWidth="960" HorizontalAlignment="Center" RowSpacing="24">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>

<StackPanel Spacing="8">
    <TextBlock x:Name="PageTitleText" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock x:Name="PageDescriptionText" Style="{StaticResource BodyTextBlockStyle}"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
</StackPanel>

<StackPanel x:Name="MonitorPage" Grid.Row="1" Spacing="12">
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="Apple Watch 蓝牙配对" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="PairingStatus" Text="准备好手表后，打开配对窗口。" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PairButton" Content="开始配对" Click="StartPairing_Click" />
                <Button x:Name="CancelPairButton" Content="停止配对" Click="StopPairing_Click" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <ComboBox x:Name="PairedWatchBox" Header="Windows 已配对设备" PlaceholderText="选择你的 Apple Watch"
                      SelectionChanged="PairedWatchBox_SelectionChanged" HorizontalAlignment="Left" MinWidth="200" />
            <TextBlock x:Name="ConnectionStatusText" Text="正在查找已配对设备…" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button x:Name="StartScanButton" Content="开始检测" Click="StartScan_Click"
                        Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                <Button x:Name="StopScanButton" Content="停止" Click="StopScan_Click" IsEnabled="False" />
                <Button x:Name="RefreshWatchesButton" Content="刷新设备" Click="RefreshWatches_Click" />
                <Button x:Name="RemoveWatchButton" Content="移除设备" Click="RemoveWatch_Click" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Border>

    <InfoBar x:Name="ScanError" IsClosable="False" Severity="Warning" />

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <ToggleSwitch x:Name="WatchWakeSwitch" Header="手表靠近时请求亮屏" IsEnabled="False"
                          Toggled="WatchWakeSwitch_Toggled" />
            <TextBlock Text="电脑锁屏且熄屏时，手表返回可请求亮屏。启用 Windows Hello 人脸识别后，Windows 可以在认出你时自动解锁。"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="WatchWakeStatus" Text="请先开始手表检测。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton x:Name="OpenSignInOptionsLink" Content="打开 Windows 登录选项" Click="OpenSignInOptions_Click" />
            <InfoBar x:Name="SignInOptionsError" IsClosable="True" Severity="Warning"
                     Message="无法打开登录选项。请在 Windows 设置中打开「账户 → 登录选项」。" />
        </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="Apple Watch 自动解锁（实验功能）" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="DirectUnlockStatus" Text="需要 Windows 登录组件和 IRK 匹配。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="DirectUnlockButton" Content="开启自动解锁…" IsEnabled="False" Click="DirectUnlock_Click" />
            <Button x:Name="SetUnlockCredentialButton" Content="设置解锁凭据…" Visibility="Collapsed" Click="SetUnlockCredential_Click" />
        </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock x:Name="PresenceText" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="LastSeenText" TextWrapping="Wrap" />
            <TextBlock x:Name="RssiText" TextWrapping="Wrap" />
            <TextBlock x:Name="PacketCountText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="IRK 换址验证" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartIrkButton" Content="自动读取并验证" Click="StartIrk_Click" IsEnabled="False" />
                <Button x:Name="StopIrkButton" Content="结束 IRK 验证" Click="StopIrk_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="IrkStatusText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <InfoBar x:Name="IrkError" IsClosable="False" Severity="Warning" />
        </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="蓝牙广播" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <ToggleSwitch x:Name="MatchingAdvertisementsSwitch" Header="仅显示匹配记录"
                              IsOn="True" OnContent="开" OffContent="关" />
                <ToggleSwitch x:Name="AutoScrollAdvertisementsSwitch" Header="自动滚动"
                              IsOn="True" OnContent="开" OffContent="关" />
            </StackPanel>
            <TextBlock x:Name="AdvertisementsStatusText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="AdvertisementsList" Height="360" SelectionMode="None"
                      AutomationProperties.Name="最近收到的蓝牙广播">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AdvertisementRow">
                        <StackPanel Spacing="4" Padding="0,8">
                            <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Payload}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</StackPanel>

<StackPanel x:Name="TrialsPage" Grid.Row="1" Spacing="12" Visibility="Collapsed">
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <ComboBox x:Name="ScenarioBox" Header="手表状态" SelectedIndex="0">
                <ComboBoxItem Content="亮屏且已解锁" />
                <ComboBoxItem Content="熄屏且已解锁" />
                <ComboBoxItem Content="重新锁定" />
                <ComboBoxItem Content="重启后尚未解锁" />
            </ComboBox>
            <TextBlock Text="开始检测后，将手表保持在接收范围内并维持选定状态。每轮 60 秒，每 10 秒统计一次是否收到匹配广播。" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button x:Name="StartTrialButton" Content="开始本轮" Click="StartTrial_Click"
                        Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                <Button x:Name="CancelTrialButton" Content="取消本轮" Click="CancelTrial_Click" IsEnabled="False" />
            </StackPanel>
            <ProgressBar x:Name="TrialProgress" Maximum="60" Visibility="Collapsed" />
            <TextBlock x:Name="TrialStatusText" Text="请先在「在场检测」开启检测。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="本次运行的测量结果" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="SummaryText" Text="暂无完整测量。" TextWrapping="Wrap" />
            <Button x:Name="CopyResultsButton" Content="复制逐窗口 CSV" Click="CopyResults_Click" IsEnabled="False" />
            <InfoBar x:Name="CopyStatus" IsClosable="True" />
        </StackPanel>
    </Border>
</StackPanel>
<StackPanel x:Name="AdvancedPage" Grid.Row="1" Spacing="12" Visibility="Collapsed">
    <InfoBar x:Name="WatchRulesStatus" IsClosable="True" />
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <TextBlock Text="Apple Watch 蓝牙连接测试" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="测试在场检测页选中的手表。确认连接后立即结束，等待新连接最多 10 秒。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="WatchConnectionLiveStatus" Text="当前连接（Windows）：未选择手表"
                       TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button x:Name="TestWatchConnectionButton" Content="测试蓝牙连接" Click="TestWatchConnection_Click" />
            <InfoBar x:Name="WatchConnectionTestStatus" IsClosable="False" />
        </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="12">
            <ToggleSwitch x:Name="AutoUnlockSwitch" Header="自动解锁" Toggled="WatchRuleToggleChanged" />
            <TextBlock Text="手动锁屏后，先确认手表离开，再按下方条件判断返回。自动锁屏后，或 Windows 从睡眠恢复且仍锁屏时，直接按下方条件判断。满足条件后向 Windows 发起一次认证。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Spacing="4">
                <NumberBox x:Name="UnlockDelayBox" Header="锁定后最短解锁等待（秒）" Minimum="0" Maximum="300"
                           SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="200"
                           ValueChanged="WatchRuleValueChanged" />
                <TextBlock Text="默认 0 秒。等待结束后，只统计这之后收到的强信号。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <NumberBox x:Name="ReturnRssiBox" Header="强信号最低 RSSI（dBm）"
                           Minimum="-126" Maximum="-1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="200"
                           ValueChanged="WatchRuleValueChanged" />
                <TextBlock Text="默认 −50 dBm。RSSI 大于或等于此值的广播才算强信号。例如设为 −55 dBm 时，−55 和 −54 dBm 都达标。阈值越低，越弱的信号也能计入。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <NumberBox x:Name="ReturnWindowBox" Header="强信号统计窗口（秒）"
                           Minimum="1" Maximum="30" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="200"
                           ValueChanged="WatchRuleValueChanged" />
                <TextBlock Text="默认 2 秒。每次判定时，从当前时刻往前统计这个时长内的达标广播。窗口越长，越能容纳间隔较大的广播。条数一旦达标即可发起认证。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <NumberBox x:Name="ReturnPacketCountBox" Header="窗口内所需广播数"
                           Minimum="1" Maximum="10" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="200"
                           ValueChanged="WatchRuleValueChanged" />
                <TextBlock Text="默认 1 条。统计窗口内每条符合条件的配对手表广播各计一次。提高条数可避免单条强信号触发，也可能使解锁变慢。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="RequireWatchUnlockedSwitch" Header="仅在手表有解锁线索时解锁电脑" Toggled="WatchRuleToggleChanged" />
                <TextBlock Text="默认关闭。开启后，每条计入的强信号广播都必须带有 Nearby Info，且解锁位 0x80 置位、锁定位 0x20 清零。字段缺失或两位同时置位的广播不计入。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="RequireEncryptedConnectionSwitch" Header="验证手表的蓝牙连接" Toggled="WatchRuleToggleChanged" />
                <TextBlock Text="Windows 确认已配对手表处于连接状态即可通过。手表尚未连接时，需要建立新连接并确认加密。" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="12">
            <ToggleSwitch x:Name="AutoLockSwitch" Header="自动锁定" Toggled="WatchRuleToggleChanged" />
            <NumberBox x:Name="WeakRssiBox" Header="弱信号阈值（dBm）" Minimum="-126" Maximum="-1"
                       SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="200"
                       ValueChanged="WatchRuleValueChanged" />
            <NumberBox x:Name="VeryWeakRssiBox" Header="极弱信号阈值（dBm）" Minimum="-126" Maximum="-1"
                       SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" MinWidth="200"
                       ValueChanged="WatchRuleValueChanged" />
            <TextBlock x:Name="AutoLockRuleDescription" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
        <StackPanel Spacing="8">
            <ToggleSwitch x:Name="SpeakLockActivitySwitch" Header="播报锁定与解锁过程" Toggled="WatchRuleToggleChanged" />
            <TextBlock Text="新步骤会打断当前播报。结束时播报总耗时。" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
</StackPanel>
</Grid>
</ScrollViewer>
</NavigationView>
</Grid>
</Grid>
</wk:ThemedWindow>




