<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="UnlockPC.WatchBindingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="BindingIllustrationTileStyle" TargetType="Border">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="BindingIllustrationIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel Spacing="12" MaxWidth="420">
        <TextBlock x:Name="StepLabel" x:FieldModifier="internal" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="StepTitle" x:FieldModifier="internal" Style="{StaticResource SubtitleTextBlockStyle}"
                   AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />

        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="8,18">
            <StackPanel x:Name="Illustration" x:FieldModifier="internal" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw" />
        </Border>

        <TextBlock x:Name="Directions" x:FieldModifier="internal" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
        <ComboBox x:Name="ExistingDevices" x:FieldModifier="internal" Header="Windows 已配对的设备"
                  HorizontalAlignment="Stretch" Visibility="Collapsed" />
        <StackPanel x:Name="Activity" x:FieldModifier="internal" Spacing="8" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="绑定进度" />
            <TextBlock x:Name="Status" x:FieldModifier="internal" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <InfoBar x:Name="Failure" x:FieldModifier="internal" Severity="Error" IsClosable="False" />
    </StackPanel>
</UserControl>
