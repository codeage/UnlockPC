<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUIKit.DialogWindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shell of DialogWindow: follows ContentDialog's layout (DefaultContentDialogStyle in generic.xaml).
         The title is merged into the title bar: Caption font size per title bar guidance (12px, consistent with other windows such as ModalNavWindow), trimmed
         when it doesn't fit on one line; the whole row drags the window, and the top-right close button is drawn by the base class.
         The body has 24 on all sides (12 from the title); the bottom command area has a one-step lighter background, a divider on top, and equal-width
         buttons (column widths are set by DialogWindow.ApplyButtons based on the number of visible buttons).
         All colors are ThemeResource and follow the window theme. -->
    <Grid x:Name="RootGrid" x:FieldModifier="internal" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" x:FieldModifier="internal" MinHeight="32" Background="Transparent">
            <TextBlock x:Name="TitleText" x:FieldModifier="internal" Margin="16,0,16,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <ScrollViewer x:Name="BodyScroller" x:FieldModifier="internal" Grid.Row="1" IsTabStop="False"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
            <Border x:Name="BodyHost" x:FieldModifier="internal" Padding="24,2,24,24"/>
        </ScrollViewer>

        <Grid x:Name="CommandBar" x:FieldModifier="internal" Grid.Row="2" Padding="24" ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Button x:Name="PrimaryButton" x:FieldModifier="internal" HorizontalAlignment="Stretch"/>
            <Button x:Name="SecondaryButton" x:FieldModifier="internal" HorizontalAlignment="Stretch"/>
            <Button x:Name="CloseButton" x:FieldModifier="internal" HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>
