<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation pane / content layer resources shared by modal navigation windows, merged into each window's root Grid.
     Shell code: WinUIKit.ModalNavWindow.
     The docked Left pane and the content layer are transparent so the window-level Mica shows as the base layer; when
     LeftCompact opens as an overlay, a theme surface color with alpha covers the content. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Navigation overlay color: about 74% opaque, keeping a clear navigation layer while the page below stays clearly visible. -->
            <Color x:Key="NavigationOverlayPaneTintColor">#FFF3F3F3</Color>
            <Color x:Key="NavigationOverlayPaneColor">#BDF3F3F3</Color>
            <!-- FallbackColor keeps alpha too: with effects available it shows in-app Acrylic; when degraded it is still a
                 translucent Fluent surface rather than an opaque white slab. -->
            <AcrylicBrush x:Key="NavigationViewDefaultPaneBackground"
                          TintColor="{ThemeResource NavigationOverlayPaneTintColor}"
                          TintOpacity="0.20"
                          TintLuminosityOpacity="0.45"
                          FallbackColor="{ThemeResource NavigationOverlayPaneColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <!-- By default the content area is a separate surface (its own background + 1px border), which is where the
                 divider line between the pane and the content comes from. Clear both so the two sides share one Mica
                 layer, like Windows Settings. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="NavigationOverlayPaneTintColor">#FF202020</Color>
            <Color x:Key="NavigationOverlayPaneColor">#BD202020</Color>
            <AcrylicBrush x:Key="NavigationViewDefaultPaneBackground"
                          TintColor="{ThemeResource NavigationOverlayPaneTintColor}"
                          TintOpacity="0.20"
                          TintLuminosityOpacity="0.45"
                          FallbackColor="{ThemeResource NavigationOverlayPaneColor}" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ───── Page layout conventions for modal navigation windows. They live here, next to the shell, because windows in
         the library reference them: if they're missing, loading the XAML fails (JIT: NavPageHeaderMargin not found;
         native precompiled XAML: a collection add failure).
         Conventions: 36 left/right margins, 4 between cards, section headers in strong body text, info bars hugging the
         card they describe, secondary text in the system secondary color.
         Merging this dictionary into the window's root Grid is enough; a standalone Page only looks up its own and
         application-level resources while loading XAML, so apps using standalone Pages must merge this dictionary into
         Application.Resources. ───── -->

    <!-- Margin of the page header (title + action buttons on the right); page content aligns with it left and right. -->
    <Thickness x:Key="NavPageHeaderMargin">36,16,36,16</Thickness>

    <!-- Page: vertical scrolling only. -->
    <Style x:Key="NavPageScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollMode" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- A page's root card stack. Also set NavShell.Reflow="True" (cards below move smoothly when a card appears/disappears). -->
    <Style x:Key="NavPageStackStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="36,0,36,36" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Nested card stack (a sub-area shown/hidden as a group): same spacing as the root stack, no margin. -->
    <Style x:Key="NavCardGroupStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <!-- Section header. The first section header on a page uses NavFirstSectionHeaderStyle (no top space; the page header already provides it). -->
    <Style x:Key="NavSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,24,0,6" />
    </Style>
    <Style x:Key="NavFirstSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,0,0,6" />
    </Style>

    <!-- Descriptive page text: the system secondary text color, not opacity. -->
    <Style x:Key="NavSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Secondary detail line inside a card: caption font size, system secondary text color. As a style with
         ThemeResource it follows light/dark theme switches; don't fetch the theme resource in code and cast it —
         under Native AOT that throws InvalidCastException (measured crash). -->
    <Style x:Key="NavCardDetailTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- An info bar hugs the card it describes: combined with the card spacing of 4 it's about 8. -->
    <Thickness x:Key="NavInfoBarMargin">0,4,0,0</Thickness>

    <!-- Width tiers for controls on the right of a card: 320 for numbers/sliders, 400 for wide info such as file names.
         Combo boxes don't use these; they are sized to their longest item (ComboBoxSizing). -->
    <x:Double x:Key="SettingsStandardControlWidth">320</x:Double>
    <x:Double x:Key="SettingsWideControlWidth">400</x:Double></ResourceDictionary>
